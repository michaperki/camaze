{
  "framework": null,
  "rewrites": [
    { "source": "/api/gateway/(.*)", "destination": "/api/gateway?rest=$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/digest", "schedule": "0 9 * * *" }
  ]
}
