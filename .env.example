# Anthropic Admin API key (starts with sk-ant-admin). Create one in
# Console -> Settings -> Organization -> Admin keys. Copy this file to .env.
ANTHROPIC_ADMIN_KEY=sk-ant-admin...

# OpenAI Admin API key (starts with sk-admin-). Create one at
# platform.openai.com -> Settings -> Organization -> Admin keys.
OPENAI_ADMIN_KEY=sk-admin-...

# Google Cloud: billing data comes from the BigQuery billing export
# (there is no cost API). The service account needs the BigQuery Data
# Viewer + Job User roles on the billing project.
#
# Local dev: point at a key file on disk.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# Deployed (e.g. Vercel): paste the entire key file contents as a string
# instead — takes priority over GOOGLE_APPLICATION_CREDENTIALS when set.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_BILLING_PROJECT=my-gcp-project
GOOGLE_BILLING_DATASET=billing_export

# Supabase: gates the dashboard behind login (Google OAuth + magic link).
# Both values are public/client-safe — served to the browser via
# /api/config, not secrets. Find them in Project Settings -> API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — used server-side only (api/keys.js, api/costs.js)
# to verify user JWTs and read/write the user_provider_keys table. This one
# IS a secret: it bypasses Row Level Security. Never expose it client-side.
# Find it in Project Settings -> API -> service_role (not anon).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encrypts provider keys at rest in user_provider_keys (see lib/crypto.js).
# Generate one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAMAZE_ENCRYPTION_KEY=64-hex-characters

# Daily email digest (public/notifications.html, api/digest.js, api/cron/digest.js).
# Resend (https://resend.com) sends the email — free tier is 3000/month.
# Create a key at resend.com -> API Keys -> Create API key.
RESEND_API_KEY=re_...
# Optional: defaults to Resend's shared test sender, which works without a
# verified domain. Set your own once you've verified a sending domain.
# RESEND_FROM_EMAIL=camaze <digest@yourdomain.com>

# Full deployed URL, used to build the "View dashboard" and "Unsubscribe"
# links in the digest email (e.g. https://camaze.vercel.app).
CAMAZE_APP_URL=https://your-app.vercel.app

# Shared secret that gates GET /api/cron/digest so it can't be triggered
# publicly. Vercel Cron automatically sends this as
# `Authorization: Bearer $CRON_SECRET` — generate any random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=random-string
