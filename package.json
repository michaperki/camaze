{
  "name": "camaze",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Anthropic spend tracker — daily cost for the last 30 days",
  "scripts": {
    "dev": "vercel dev",
    "test": "node --test test/*.test.js",
    "dev:insights": "npm run build && node scripts/insights-preview.js",
    "inspect:insights-source": "node scripts/inspect-insights-source.js",
    "refresh:insights-evidence": "node scripts/refresh-insights-evidence.js",
    "test:insights-ui": "npm run test:ui",
    "build": "vite build",
    "dev:ui": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test:ui": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.12.0",
    "@floating-ui/dom": "^1.8.0",
    "@formkit/auto-animate": "^0.10.0",
    "@supabase/supabase-js": "^2.116.0",
    "canvas-confetti": "^1.9.4",
    "echarts": "^6.1.0",
    "lucide": "^1.46.0",
    "motion": "^13.3.0",
    "tabulator-tables": "^6.5.2",
    "zod": "^4.6.5"
  }
}
