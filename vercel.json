{
  "framework": null,
  "rewrites": [
    {
      "source": "/api/sim/:route*",
      "destination": "/api/sim?route=:route*"
    },
    {
      "source": "/sim",
      "destination": "/dashboard.html"
    },
    {
      "source": "/sim/",
      "destination": "/dashboard.html"
    },
    {
      "source": "/sim/dashboard.html",
      "destination": "/dashboard.html"
    },
    {
      "source": "/sim/assignments.html",
      "destination": "/assignments.html"
    },
    {
      "source": "/sim/integrations.html",
      "destination": "/integrations.html"
    },
    {
      "source": "/sim/notifications.html",
      "destination": "/notifications.html"
    },
    {
      "source": "/sim/insights.html",
      "destination": "/insights.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/",
      "destination": "/dashboard.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/insights",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/cost-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/alerts",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "api/cron/insights.js": {
      "maxDuration": 120
    },
    "api/cron/cost-sync.js": {
      "maxDuration": 300
    },
    "api/cron/digest.js": {
      "maxDuration": 300
    },
    "api/cron/alerts.js": {
      "maxDuration": 300
    },
    "api/cron/reconcile.js": {
      "maxDuration": 300
    },
    "api/costs.js": {
      "maxDuration": 300
    },
    "api/org.js": {
      "maxDuration": 60
    },
    "api/sim.js": {
      "maxDuration": 300
    }
  }
}
